# Saakshi Environment Configuration (Air-Gapped Forensic Deployment)

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_secure_random_key_for_production_use

# Database (PostgreSQL 16)
POSTGRES_USER=saakshi
POSTGRES_PASSWORD=saakshi_secure_pass
POSTGRES_DB=saakshi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://saakshi:saakshi_secure_pass@postgres:5432/saakshi_db

# Asynchronous Task Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage Locations (Read-Only Mounts for Forensic Evidence)
EVIDENCE_VAULT_PATH=/data/evidence
CASE_STORAGE_PATH=/data/cases
TEMP_CARVE_PATH=/data/scratch

# Custody & Anchoring
CUSTODY_LOG_PATH=/data/custody/custody_chain.jsonl
ANCHOR_BACKEND=local
# FABRIC_PEER_ENDPOINT=grpc://peer0.org1.example.com:7051

# Offline / Air-Gapped Enforcement
AIR_GAPPED_MODE=true
ALLOW_OUTBOUND_NETWORK=false
