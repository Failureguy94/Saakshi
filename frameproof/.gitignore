.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js

# Database & Environment
*.env
!.env.example
*.sqlite
*.sqlite3
*.db
data/
postgres_data/
redis_data/

# Forensic Evidence Protection: NEVER commit evidence images or raw disk dumps!
*.dd
*.raw
*.img
*.e01
*.E01
*.bin
*.vmdk
samples/*.raw
samples/*.dd
samples/*.img
!samples/README.md
!backend/tests/fixtures/synthetic_sample.raw

# OS and IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo
